FROM node:24-bookworm-slim AS frontend
WORKDIR /build
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM maven:3.9-eclipse-temurin-21 AS backend
WORKDIR /build
COPY backend/pom.xml ./
COPY backend/src src
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre AS java

FROM node:24-bookworm-slim
WORKDIR /app
COPY --from=java /opt/java/openjdk /opt/java/openjdk
COPY --from=frontend --chown=node:node /build/.next/standalone ./
COPY --from=frontend --chown=node:node /build/.next/static ./.next/static
COPY --from=frontend --chown=node:node /build/public ./public
COPY --from=backend /build/target/media-cable-vision-1.0.0.jar ./backend.jar
COPY scripts/start-staging.sh ./start-staging.sh
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=10000 \
    BACKEND_URL=http://127.0.0.1:8080 NOTIFICATION_MODE=mock
USER node
EXPOSE 10000
CMD ["bash", "./start-staging.sh"]
